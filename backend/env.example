# ===========================================
# Iron Stag Backend Environment Variables
# Local development only. Railway production reads its own Variables.
# ===========================================

# ---------------- DATABASE -----------------
# Use a dev/staging database here, never production.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ---------------- AI (OpenAI) --------------
OPENAI_API_KEY="sk-..."
OPENAI_ANALYSIS_MODEL="gpt-4.1"
OPENAI_REANALYSIS_MODEL="gpt-4.1"
OPENAI_MODEL_AB_TEST_ENABLED="false"
OPENAI_MODEL_AB_TEST_CANDIDATE="gpt-5.4"
OPENAI_MODEL_AB_TEST_PERCENT="50"
OPENAI_MODEL_AB_TEST_SALT="ironstag-model-ab-v1"

# -------- Selective Consensus (Optional) ---
SELECTIVE_CONSENSUS_ENABLED="true"
SELECTIVE_CONSENSUS_TOTAL_PASSES="3"
SELECTIVE_CONSENSUS_TRIGGER_MAX_AGE_CONFIDENCE="78"
SELECTIVE_CONSENSUS_TRIGGER_MAX_RECOMMENDATION_CONFIDENCE="80"
SELECTIVE_CONSENSUS_TRIGGER_HARVEST_WINDOW="0.5"
SELECTIVE_CONSENSUS_AGE_SPREAD_PENALTY_PER_HALF_YEAR="8"
SELECTIVE_CONSENSUS_DISAGREEMENT_PENALTY="12"

# ------------ AUTHENTICATION ---------------
JWT_SECRET="replace-with-a-long-random-secret"

# ------------- PAYMENTS --------------------
STRIPE_SECRET_KEY="sk_..."
STRIPE_PUBLISHABLE_KEY="pk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
REVENUECAT_PUBLIC_KEY="..."
REVENUECAT_SECRET_KEY="..."

# ----------- EMAIL (Microsoft Graph) -------
MICROSOFT_GRAPH_CLIENT_ID="..."
MICROSOFT_GRAPH_CLIENT_SECRET="..."
MICROSOFT_GRAPH_TENANT_ID="..."
MS_GRAPH_SENDER_EMAIL="support@example.com"

# ----------- SERVER (Optional) -------------
# PORT=8001
