EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_MZUtDk1KjnEPjVZDnQWAiYxPQAV
EXPO_USE_FAST_RESOLVER="1"
METRO_CACHE_ROOT=/app/frontend/.metro-cache
