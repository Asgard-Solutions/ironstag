# Let Expo detect the local Metro host automatically for Expo Go.
# Do not point packager/tunnel vars at production while testing locally.

# For a physical phone on the same Wi-Fi, replace localhost with your computer's LAN IP.
# Example: http://192.168.1.25:8001
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.249:8001
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.249:8001
