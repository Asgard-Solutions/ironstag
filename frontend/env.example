# Local Expo development defaults.
# Let Expo detect the Metro host automatically.
# If you test on a physical device, replace localhost with your machine's LAN IP.

EXPO_PUBLIC_API_BASE_URL=http://localhost:8001
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=sk_...
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...
